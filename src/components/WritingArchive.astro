---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { site, url } from '../lib/site';
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'posts'>[]; home?: boolean; current?: number; total?: number; }
const { posts, home = false, current = 1, total = 1 } = Astro.props;
const pageUrl = (page: number) => page === 1 ? url(home ? '' : 'writing/') : url(`${home ? '' : 'writing/'}page/${page}/`);
---
<Base title={home && current === 1 ? undefined : `Tekstovi${current > 1 ? ` · ${current}` : ''}`}>
<header class="archive-heading"><h1>{home ? site.name : 'Tekstovi'}</h1>{home && <p>{site.description}</p>}</header>
<PostList posts={posts} />
{total > 1 && <nav class="pagination" aria-label="Stranice tekstova">{current > 1 && <a href={pageUrl(current - 1)} rel="prev">← Noviji tekstovi</a>}<span>Stranica {current} od {total}</span>{current < total && <a href={pageUrl(current + 1)} rel="next">Stariji tekstovi →</a>}</nav>}
</Base>
<style>
.archive-heading { padding-block:2rem 1.5rem; text-align:center; }
.archive-heading h1 { margin:0 0 .75rem; }
.archive-heading p { color:var(--muted); margin:0; font-family:var(--serif); font-size:1.25rem; }
.pagination { justify-content:space-between; align-items:center; margin-bottom:2rem; font-family:var(--mono); font-size:.875rem; }
.pagination a { min-height:44px; display:inline-flex; align-items:center; }
</style>