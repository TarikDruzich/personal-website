---
import '../styles/global.css';
import { site, url } from '../lib/site';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; article?: boolean; published?: string; updated?: string; canonicalPath?: string; noindex?: boolean; }
const { title, description = site.description, image, imageAlt, article = false, published, updated, canonicalPath, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(canonicalPath || Astro.url.pathname, Astro.site!);
const imageUrl = image ? new URL(url(image), Astro.site!).href : undefined;
const links = [{ path: '', label: 'Početna' }, { path: 'writing/', label: 'Tekstovi' }];
---
<!doctype html>
<html lang="bs">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#17191b" /><meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — tekstovi`} href={url('rss.xml')} />
    <meta property="og:locale" content="bs_BA" /><meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:url" content={canonical} />
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} /><meta name="twitter:description" content={description} />
    {imageUrl && <><meta property="og:image" content={imageUrl} /><meta property="og:image:alt" content={imageAlt} /><meta name="twitter:image" content={imageUrl} /></>}
    {published && <meta property="article:published_time" content={published} />}
    {updated && <meta property="article:modified_time" content={updated} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
  </head>
  <body>
    <a class="skip-link" href="#content">Preskoči na sadržaj</a>
    <div class="shell">
      <header class="site-header"><a class="wordmark" href={url()} aria-label="Tarik Družić — početna">{site.name}</a>
        <nav aria-label="Glavna navigacija">{links.map(({path, label}) => <a href={url(path)} aria-current={(path ? Astro.url.pathname.startsWith(url(path)) : Astro.url.pathname === url()) ? 'page' : undefined}>{label}</a>)}</nav>
      </header>
      <main id="content" tabindex="-1"><slot /></main>
      <footer class="site-footer"><span>{site.name}</span><a href={url('rss.xml')}>RSS</a></footer>
    </div>
  </body>
</html>
